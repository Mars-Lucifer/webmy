---
interface Props {
  title: string;
  description: string;
  image: string;
  link?: string;
  theme?: "light" | "dark";
  status?: {
    dotColor: string;
    text: string;
  } | null;
  index: number;
  kind: "web" | "presentation";
}

const {
  title,
  description,
  image,
  link,
  theme = "light",
  status = null,
  index,
  kind,
} = Astro.props;

const isDark = theme === "dark";
const cardClasses = `col-span-4 md:col-span-2 group flex flex-col p-[0.25rem] rounded-[2rem] overflow-hidden opacity-0 reveal-trigger transition-transform duration-300 hover:scale-[1.02] ${isDark ? "bg-[#1F2229]" : "bg-white"} ${link ? "cursor-pointer" : "cursor-default"}`;
const animation = `fade-scale-blur delay-${Math.min((index % 2) * 100 + 100, 300)}`;
---

{
  link ? (
    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class={cardClasses}
      data-project-card
      data-project-kind={kind}
      data-project-index={index}
      data-anim={animation}
    >
      <img
        src={image}
        alt={title}
        class="w-full aspect-[1.8] object-cover rounded-[1.75rem]"
        loading="lazy"
      />

      <div class="flex flex-col p-[1.5rem] gap-[0.5rem] justify-start items-start h-full flex-1">
        <div class="flex flex-col gap-[0.5rem] w-full">
          <div class="flex justify-between items-center gap-[0.75rem] w-full">
            <h3
              class={`flex-1 text-[1.5rem] font-medium leading-[1.07] ${isDark ? "text-[#EDEEF0]" : "text-[#1F2229]"}`}
              data-project-title
            >
              {title}
            </h3>

            <div
              class={`w-[1.5rem] h-[1.5rem] relative shrink-0 opacity-50 group-hover:opacity-100 transition-opacity duration-300 ${isDark ? "text-[#EDEEF0]" : "text-[#1F2229]"}`}
              aria-hidden="true"
            >
              <svg
                width="100%"
                height="100%"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="stroke-current"
              >
                <path
                  d="M7 7H17V17"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M7 17L17 7"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </div>

          <p
            class="text-[#828894] text-[1rem] font-normal leading-[1.07] max-w-[30rem]"
            data-project-description
          >
            {description}
          </p>
        </div>

        {status && (
          <div class="flex items-center gap-[0.5rem] mt-auto pt-[0.25rem]">
            <div
              class={`w-[0.5rem] h-[0.5rem] rounded-full ${status.dotColor}`}
            />
            <span
              class="text-[rgba(130,136,147,0.60)] text-[1rem] font-normal leading-[1.07]"
              data-project-status
            >
              {status.text}
            </span>
          </div>
        )}
      </div>
    </a>
  ) : (
    <div
      class={cardClasses}
      data-project-card
      data-project-kind={kind}
      data-project-index={index}
      data-anim={animation}
    >
      <img
        src={image}
        alt={title}
        class="w-full aspect-[1.8] object-cover rounded-[1.75rem]"
        loading="lazy"
      />
      <div class="flex flex-col p-[1.5rem] gap-[0.5rem] justify-start items-start h-full flex-1">
        <h3
          class={`text-[1.5rem] font-medium leading-[1.07] ${isDark ? "text-[#EDEEF0]" : "text-[#1F2229]"}`}
          data-project-title
        >
          {title}
        </h3>
        <p
          class="text-[#828894] text-[1rem] font-normal leading-[1.07]"
          data-project-description
        >
          {description}
        </p>
      </div>
    </div>
  )
}
