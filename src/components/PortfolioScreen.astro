---
import PortfolioCard from "./PortfolioCard.astro";

const webProjects = [
  {
    title: "Lucid мобильное приложение",
    description:
      "Мобильное приложение для отслеживания трат и учета своих финансов",
    image: "/image/port_0.webp",
    theme: "light" as const,
    link: "https://www.figma.com/design/vANrOmziqiaG6DFkGt6ldj/Lucid?node-id=0-1&t=lbkdHFVNJdaJrdlF-1",
    status: { dotColor: "bg-[rgba(0,222,96,0.60)]", text: "В разработке" },
  },
  {
    title: "Mochiland",
    description:
      "B2B-платформа для компании Mochiland, автоматизирующая сделки поставки их товара",
    image: "/image/port_1.webp",
    theme: "light" as const,
    link: "https://mochi-partners.ru",
    status: { dotColor: "bg-[rgba(0,222,96,0.60)]", text: "В разработке" },
  },
  {
    title: "Артур Одилов",
    description: "Сайт-портфолио для профессионального фотографа Москвы",
    image: "/image/port_2.webp",
    theme: "dark" as const,
    link: "https://arturjan.ru/",
    status: null,
  },
  {
    title: "Российское Содружество Колледжей",
    description:
      "Полноценная всероссийская платформа, включает множество функций для развития образовательных учреждений",
    image: "/image/port_3.webp",
    theme: "light" as const,
    link: "https://rosdk.ru",
    status: null,
  },
  {
    title: "Oasis",
    description:
      "Полный пак для компании по озеленению, включающий фирменный стиль, сайт, AI-бота",
    image: "/image/port_4.webp",
    theme: "light" as const,
    link: "https://oasis.rybalkon.ru/",
    status: null,
  },
  {
    title: "EnergyStart",
    description:
      "Фирменный стиль и сайт компании, занимающейся разработкой систем повышения эффективности ЖКХ",
    image: "/image/port_5.webp",
    theme: "light" as const,
    link: "https://energystart.ru",
    status: null,
  },
];

const presentations = [
  {
    title: "Отчет энергокомпании",
    description:
      "Отчетная презентация энергокомпании с ключевыми показателями, динамикой развития и планами.",
    image: "/presentations/energy-report.png",
    link: "/presentations/energy-report.pdf",
  },
  {
    title: "Коммерческое предложение B2B",
    description:
      "Короткое коммерческое предложение о B2B-платформе для бизнеса.",
    image: "/presentations/b2b-commercial-proposal.png",
    link: "/presentations/b2b-commercial-proposal.pdf",
    theme: "dark" as const,
  },
  {
    title: "Oishi брендбук",
    description:
      "Презентация-брендбук для бренда азиатской кухни и сообщества Oishi.",
    image: "/presentations/oishi-brandbook.png",
    link: "/presentations/oishi-brandbook.pdf",
    theme: "dark" as const,
  },
  {
    title: "Мочиленд для бизнеса",
    description:
      "Презентация поставщика десертов моти для бизнеса с особыми условиями сотрудничества.",
    image: "/presentations/mochiland-for-business.png",
    link: "/presentations/mochiland-for-business.pdf",
  },
];
---

<section
  id="portfolio"
  class="w-full flex flex-col gap-[3.75rem] mt-[7.5rem] scroll-mt-[7.5rem]"
>
  <div class="grid-layout w-full items-center gap-y-[2rem]">
    <div
      class="col-span-4 md:col-span-1 flex justify-between items-center text-[var(--color-black)] text-[1.25rem] font-medium uppercase w-full opacity-0 reveal-trigger"
      data-anim="fade-scale-blur"
    >
      <span>/</span>
      <span data-i18n="portfolio.sectionLabel">портфолио</span>
      <span>/</span>
    </div>

    <div
      class="col-span-4 md:col-span-3 flex md:justify-end opacity-0 reveal-trigger"
      data-anim="fade-scale-blur delay-100"
    >
      <div
        class="inline-flex w-full md:w-auto p-[0.25rem] rounded-[1.25rem] bg-white"
        role="tablist"
        aria-label="Категории портфолио"
      >
        <button
          type="button"
          id="portfolio-tab-web"
          class="portfolio-tab flex-1 md:flex-none px-[1.5rem] py-[1rem] rounded-[1rem] text-[1rem] font-medium transition-colors duration-300 bg-[var(--color-black)] text-white"
          role="tab"
          aria-selected="true"
          aria-controls="portfolio-panel-web"
          data-portfolio-tab="web"
          data-i18n="portfolio.tabs.web"
        >
          Web-проекты
        </button>
        <button
          type="button"
          id="portfolio-tab-presentations"
          class="portfolio-tab flex-1 md:flex-none px-[1.5rem] py-[1rem] rounded-[1rem] text-[1rem] font-medium transition-colors duration-300 text-[var(--color-gray-text)] hover:text-[var(--color-black)]"
          role="tab"
          aria-selected="false"
          aria-controls="portfolio-panel-presentations"
          tabindex="-1"
          data-portfolio-tab="presentations"
          data-i18n="portfolio.tabs.presentations"
        >
          Презентации
        </button>
      </div>
    </div>
  </div>

  <div
    id="portfolio-panel-web"
    class="grid-layout w-full"
    role="tabpanel"
    aria-labelledby="portfolio-tab-web"
    data-portfolio-panel="web"
  >
    {
      webProjects.map((project, index) => (
        <PortfolioCard {...project} index={index} kind="web" />
      ))
    }
  </div>

  <div
    id="portfolio-panel-presentations"
    class="grid-layout w-full"
    role="tabpanel"
    aria-labelledby="portfolio-tab-presentations"
    data-portfolio-panel="presentations"
    hidden
  >
    {
      presentations.map((project, index) => (
        <PortfolioCard {...project} index={index} kind="presentation" />
      ))
    }
  </div>
</section>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-portfolio-tab]"),
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>("[data-portfolio-panel]"),
  );

  const selectTab = (selected: HTMLButtonElement) => {
    const selectedName = selected.dataset.portfolioTab;

    tabs.forEach((tab) => {
      const isActive = tab === selected;
      tab.setAttribute("aria-selected", String(isActive));
      tab.tabIndex = isActive ? 0 : -1;
      tab.classList.toggle("bg-[var(--color-black)]", isActive);
      tab.classList.toggle("text-white", isActive);
      tab.classList.toggle("text-[var(--color-gray-text)]", !isActive);
      tab.classList.toggle("hover:text-[var(--color-black)]", !isActive);
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.portfolioPanel !== selectedName;
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectTab(tab));
    tab.addEventListener("keydown", (event) => {
      if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key))
        return;
      event.preventDefault();

      const nextIndex =
        event.key === "Home"
          ? 0
          : event.key === "End"
            ? tabs.length - 1
            : (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) %
              tabs.length;

      const nextTab = tabs[nextIndex];
      if (nextTab) {
        selectTab(nextTab);
        nextTab.focus();
      }
    });
  });
</script>
